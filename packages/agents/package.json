{
  "name": "jq-agents",
  "version": "0.1.0",
  "description": "A local, read-only board of every Claude Code session on your machine: what each is doing and which are waiting on a person. Unofficial; not affiliated with or endorsed by Anthropic.",
  "bin": { "jq-agents": "dist/jq-agents.mjs" },
  "type": "module",
  "exports": { ".": "./dist/index.mjs" },
  "files": ["dist/jq-agents.mjs", "dist/index.mjs", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=18" },
  "keywords": ["claude-code", "coding-agents", "multi-agent", "developer-tools", "ai-coding"],
  "author": "Point Seven Studio",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/point-seven-studio/jq-tools.git", "directory": "packages/agents" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "./build.sh",
    "check": "npm run typecheck && npm test && ./build.sh --check",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
