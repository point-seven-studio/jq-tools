{
  "name": "@point-seven-studio/jq-crosstalk",
  "version": "0.1.3",
  "description": "A file mailbox for agent sessions that work side by side: briefs, questions, threads, and a shared board for questions anyone may answer. Plain files on your machine; sends nothing anywhere.",
  "bin": {
    "crosstalk": "bin/crosstalk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "bin/crosstalk",
    "dist/view.mjs",
    "dist/index.mjs",
    "dist/types",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "coding-agents",
    "multi-agent",
    "mailbox",
    "developer-tools",
    "ai-coding"
  ],
  "author": "Point Seven Studio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/point-seven-studio/jq-tools.git",
    "directory": "packages/crosstalk"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "./build.sh",
    "check": "npm run typecheck && npm test && ./build.sh --check",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/point-seven-studio/jq-tools/tree/main/packages/crosstalk#readme",
  "bugs": {
    "url": "https://github.com/point-seven-studio/jq-tools/issues"
  },
  "types": "./dist/types/index.d.ts"
}
